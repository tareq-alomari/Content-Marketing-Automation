{
  "name": "W08-publishing-distribution",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "w08-trigger",
      "name": "Schedule (Hourly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1600, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Content Platforms",
          "mode": "name"
        },
        "options": {
          "keyRow": 1
        }
      },
      "id": "w08-read",
      "name": "Read Approved Items",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-1400, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets (Service Account)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst due = rows.filter(r => {\n  const approved = (r.status || r.Status || '').toLowerCase() === 'approved';\n  const pub = r.publish_date || r['Publishing Date'];\n  const pubOk = !pub || new Date(pub) <= now;\n  const notPublished = !r.published;\n  return approved && pubOk && notPublished;\n});\nreturn due;",
        "mode": "runOnceForAllItems"
      },
      "id": "w08-filter",
      "name": "Filter Due + Approved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nif (rows.length === 0) return [];\nconst pre = rows.map(r => ({\n  json: {\n    ...r.json,\n    pre_publish_ok: !!r.json.copy && !!r.json.platform,\n    media_ok: !r.json.media_ref || true\n  }\n}));\nreturn pre;",
        "mode": "runOnceForAllItems"
      },
      "id": "w08-publish-gate",
      "name": "Pre-Publish Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1000, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "profile": "={{ $json.platform }}",
        "channel": {
          "name": "={{ $json.platform }}"
        },
        "options": {
          "media": {
            "url": "={{ $json.media_ref }}"
          }
        },
        "content": "={{ $json.copy }}\\n\\n{{ ($json.hashtags || []).join(' ') }}",
        "scheduleType": "queue"
      },
      "id": "w08-buffer",
      "name": "Buffer Schedule Post",
      "type": "n8n-nodes-base.buffer",
      "typeVersion": 1.1,
      "position": [-800, 0],
      "credentials": {
        "bufferApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Buffer API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$input.first().json, published: true, published_at: new Date().toISOString() } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "w08-mark",
      "name": "Mark Published",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Content Platforms",
          "mode": "name"
        },
        "options": {
          "keyRow": 1
        }
      },
      "id": "w08-update-sheet",
      "name": "Update Publication Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-400, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets (Service Account)"
        }
      }
    },
    {
      "parameters": {
        "channel": {
          "value": "={{ $env.SLACK_CHANNEL }}"
        },
        "text": "={{ 'منشور جديد: ' + $json.copy?.slice(0, 80) }}",
        "options": {
          "attachments": []
        }
      },
      "id": "w08-notify",
      "name": "Slack Team Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [-200, 0],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack App"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { workflow: 'W08', status: 'done', published: $input.all().length } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "w08-done",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    }
  ],
  "connections": {
    "Schedule (Hourly)": {
      "main": [
        [{ "node": "Read Approved Items", "type": "main", "index": 0 }]
      ]
    },
    "Read Approved Items": {
      "main": [
        [{ "node": "Filter Due + Approved", "type": "main", "index": 0 }]
      ]
    },
    "Filter Due + Approved": {
      "main": [
        [{ "node": "Pre-Publish Checks", "type": "main", "index": 0 }]
      ]
    },
    "Pre-Publish Checks": {
      "main": [
        [{ "node": "Buffer Schedule Post", "type": "main", "index": 0 }]
      ]
    },
    "Buffer Schedule Post": {
      "main": [
        [{ "node": "Mark Published", "type": "main", "index": 0 }]
      ]
    },
    "Mark Published": {
      "main": [
        [{ "node": "Update Publication Status", "type": "main", "index": 0 }]
      ]
    },
    "Update Publication Status": {
      "main": [
        [{ "node": "Slack Team Notification", "type": "main", "index": 0 }]
      ]
    },
    "Slack Team Notification": {
      "main": [
        [{ "node": "Summary", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}